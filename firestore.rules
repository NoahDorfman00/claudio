rules_version = '2';

// Signed-in (non-guest) users can read and write their own chats, which is how chats follow an
// account across devices. Everything else (trial usage, subscription status, encrypted API keys,
// welcome messages) is touched only by the Cloud Functions through the Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{uid}/chats/{chatId} {
      allow read, write: if isOwner(uid);

      match /messages/{messageId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
